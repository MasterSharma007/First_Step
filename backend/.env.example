# Copy to .env and fill in. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://bn_user:bn_password@localhost:5433/banknifty
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://bn_user:bn_password@localhost:5672/

# Kite Connect (https://kite.trade/connect/login)
KITE_API_KEY=
KITE_API_SECRET=
# Generated daily by the login flow (app/services/kite/client.py) - do not
# hardcode a long-lived token, it expires every trading day.
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/api/v1/kite/callback

TRADING_SYMBOL=NIFTY BANK
TRADING_EXCHANGE=NFO
NFO_UNDERLYING=BANKNIFTY
PAPER_TRADING=true
PAPER_TRADING_CAPITAL=100000
RISK_PER_TRADE_PCT=3.0
MAX_DAILY_LOSS=10000
MAX_TRADE_LOSS=4000
MAX_OPEN_POSITIONS=2
RISK_REWARD_RATIO=2.0

# Live paper trading loop - off by default, opt in once you've backfilled
# spot history and are comfortable with it auto-opening paper positions.
LIVE_LOOP_ENABLED=false
LIVE_LOOP_INTERVAL_SECONDS=10
EOD_SQUARE_OFF_TIME=15:38
