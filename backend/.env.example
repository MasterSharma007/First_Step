# Copy to .env and fill in. Never commit the real .env file.

ENVIRONMENT=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://bn_user:bn_password@localhost:5432/banknifty
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://bn_user:bn_password@localhost:5672/

# Kite Connect (https://kite.trade/connect/login)
KITE_API_KEY=
KITE_API_SECRET=
# Generated daily by the login flow (app/services/kite/client.py) - do not
# hardcode a long-lived token, it expires every trading day.
KITE_ACCESS_TOKEN=
KITE_REDIRECT_URL=http://localhost:8000/api/v1/kite/callback

TRADING_SYMBOL=NIFTY BANK
TRADING_EXCHANGE=NFO
PAPER_TRADING=true
MAX_DAILY_LOSS=10000
MAX_TRADE_LOSS=2000
MAX_OPEN_POSITIONS=2
RISK_REWARD_RATIO=2.0
